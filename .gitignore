!src/database/sql/data_load/mocks/usuario.csv
!src/database/sql/data_load/mocks/empresa.csv
!src/database/sql/data_load/mocks/marca.csv
!src/database/sql/data_load/mocks/classe_quimica.csv
!src/database/sql/data_load/mocks/substancia.csv
!src/database/sql/data_load/seeds/*.csv
