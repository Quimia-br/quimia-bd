# Copie para .env (ignorado pelo git) e preencha. Nunca versione valores reais.

# --- Banco do Quimia (psycopg2): setup_data, geradores, loader, ops/ ---------------
# src/database/connection.py conecta sempre com sslmode=require.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Banco do Quimia (SQLAlchemy): log do RPA e gerador de cômodos -----------------
# Mesmo banco das variáveis DB_* acima, em formato de URL.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?sslmode=require
DB_URL=

# --- Banco legado (origem do RPA, somente leitura) ---------------------------------
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?sslmode=require
RPA_DB_URL=

# --- Opcionais: ops/restore.py e ops/pgbin.py --------------------------------------
# Senha do banco de DESTINO do restore (nunca o banco de entrega).
RESTORE_PGPASSWORD=
# sslmode do destino do restore (padrão: prefer).
RESTORE_PGSSLMODE=
# Imagem Docker usada quando pg_dump/pg_restore não estão no PATH (padrão: postgres:18).
PG_TOOLS_IMAGE=
